{
  "log": { "level": "info" },
  "lx": {
    "wg": {
      "idle_suspend": "30s",
      "idle_suspend_reachable": "5m",
      "idle_teardown": "10m",
      "lazy_build": true,
      "build_max": 4,
      "build_overflow": "wait"
    }
  },
  "inbounds": [
    { "type": "mixed", "tag": "mixed-in", "listen": "127.0.0.1", "listen_port": 2080 }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" }
  ],
  "endpoints": [
    {
      "type": "masque-client", "tag": "masque-global",
      "server": "127.0.0.1", "server_port": 443,
      "tls": { "enabled": true, "server_name": "example.com" },
      "path": "/.well-known/masque/ip/{target}/{ipproto}/"
    },
    {
      "type": "masque-client", "tag": "masque-on-demand",
      "server": "127.0.0.1", "server_port": 443,
      "tls": { "enabled": true, "server_name": "example.com" },
      "path": "/.well-known/masque/ip/{target}/{ipproto}/",
      "on_demand": true
    },
    {
      "type": "masque-client", "tag": "warp-profile",
      "server": "192.0.2.1", "server_port": 443,
      "profile": "cloudflare",
      "private_key": "MHcCAQEEIC70rSMGJCq7fljQtliuNyPfMs3ARNQwvUG2PEf8Wg5RoAoGCCqGSM49AwEHoUQDQgAEFAWI4wolppk3WeP0VpNPq2dK0BBEt5iUclPkFNejAc5Bzyzy2YEjdtUSg1MaCpeTK5v11R0Db12WzC7j0uTSzw==",
      "public_key": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEFAWI4wolppk3WeP0VpNPq2dK0BBEt5iUclPkFNejAc5Bzyzy2YEjdtUSg1MaCpeTK5v11R0Db12WzC7j0uTSzw==",
      "address": ["172.16.0.2/32", "2001:db8::2/128"],
      "on_demand": true
    }
  ],
  "route": { "final": "direct" }
}
